# SakSuuu Top-Up Environment Variables Example
# Duplicate this file to .env.local for local development or add these keys to your hosting platform (e.g. Vercel)

# Application URL (Change to your production domain, e.g. https://your-site.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public social destinations. Set real profile URLs to show their toolbar icons.
# Restart development or rebuild after changing these NEXT_PUBLIC_ values.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TELEGRAM_SUPPORT=https://t.me/saksuuu_support

# MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Vizo Supplier API
VIZO_BASE_URL=https://api.vizoapp.store
VIZO_API_KEY=your_vizo_api_key_here

# G2Bulk Supplier API
G2BULK_BASE_URL=https://api.g2bulk.com/v1
G2BULK_API_KEY=your_g2bulk_api_key_here

# WebBuilder Reseller API (Server-to-Server, Honor of Kings)
# Never expose or commit this key. Set WEBBUILDER_API_KEY on the server / hosting platform environment.
WEBBUILDER_BASE_URL=https://webbuilderservice.dev/v1
WEBBUILDER_API_KEY=your_webbuilder_api_key_here
# Optional Webhook Signing Secret for verifying incoming final-status webhooks
WEBBUILDER_WEBHOOK_SECRET=your_webbuilder_webhook_secret_here

# AnajakPay Payment Gateway
ANAJAKPAY_PROFILE_ID=your_anajakpay_profile_id
ANAJAKPAY_SECRET_KEY=your_anajakpay_secret_key

# Admin Authentication Session Secret (random 32+ hex/string)
AUTH_SECRET=your_random_auth_secret_key_here

# Optional bootstrap login, used only before any database admin account exists.
# Prefer creating an account with npm run admin:setup. No default login is enabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Blob Storage Token (created in Vercel Dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx
