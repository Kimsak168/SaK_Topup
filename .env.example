# SakSuuu Top-Up Environment Variables Example
# Duplicate this file to .env.local for local development or add these keys to your hosting platform (e.g. Vercel)

# Application URL (Change to your production domain, e.g. https://your-site.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public social destinations. Set real profile URLs to show their toolbar icons.
# Restart development or rebuild after changing these NEXT_PUBLIC_ values.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TELEGRAM_SUPPORT=https://t.me/Asuratopupstore

# MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Required in Production. Set the confirmed Atlas database name; no Production default is used.
MONGODB_DB_NAME=


# WebBuilder Reseller API (Server-to-Server, Honor of Kings)
# Never expose or commit this key. Set WEBBUILDER_API_KEY on the server / hosting platform environment.
WEBBUILDER_BASE_URL=https://webbuilderservice.dev/v1
WEBBUILDER_API_KEY=your_webbuilder_api_key_here
# Optional Webhook Signing Secret for verifying incoming final-status webhooks
WEBBUILDER_WEBHOOK_SECRET=your_webbuilder_webhook_secret_here

# KHQR PAY Gateway (https://khqrpay.site)
# Server-to-server payment gateway for direct PayWay KHQR codes and ABA Mobile deep linking.
# Obtain API key from https://khqrpay.site/dashboard (Bearer sk_...)
KHQRPAY_BASE_URL=https://khqrpay.site
KHQRPAY_API_KEY=your_khqrpay_api_key_here
KHQRPAY_WEBHOOK_SECRET=your_khqrpay_webhook_secret_here

# Admin Authentication Session Secret (random 32+ hex/string)
AUTH_SECRET=your_random_auth_secret_key_here

# Optional bootstrap login, used only before any database admin account exists.
# Prefer creating an account with npm run admin:setup. No default login is enabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional public Vercel Blob store (Vercel Dashboard -> Storage -> Blob).
# Leave blank to store banner, event, and package image files in MongoDB.
# Direct uploads over 4 MB and game/branding uploads require a real token.
# Set the same token on each deployment that shares the image URLs.
BLOB_READ_WRITE_TOKEN=

# Admin-only Telegram notifications (server-side only; never use NEXT_PUBLIC_ or expose in frontend).
# See docs/telegram-setup-guide.md for step-by-step setup and group ID retrieval.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional separate Telegram Bot Token for Customer Mini App & Bot (e.g. Asura_Xbot)
TELEGRAM_CUSTOMER_BOT_TOKEN=

# Optional Telegram Forum Topics (Thread IDs for groups with Topics enabled):
# Set these to route notifications to specific topics (e.g. ⁉️ Peddling, 💎 Success, 💡 Failed).
# If left blank, notifications are posted to the main / General chat.
TELEGRAM_TOPIC_PENDING=
TELEGRAM_TOPIC_SUCCESS=
TELEGRAM_TOPIC_FAILED=
# Random shared secret for Vercel Cron or an external scheduler's Bearer header.
CRON_SECRET=
