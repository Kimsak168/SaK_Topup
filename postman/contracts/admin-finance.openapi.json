{
  "openapi": "3.1.0",
  "info": {
    "title": "SakSuuu Admin Finance and Supplier API",
    "version": "1.0.0",
    "description": "Authenticated administrative finance views and supplier account telemetry. Secrets and raw upstream payloads are never returned. Supplier balances are labeled live, cached, manual, or unavailable."
  },
  "servers": [{ "url": "https://{host}", "variables": { "host": { "default": "example.invalid" } } }],
  "security": [{ "adminCookie": [] }],
  "paths": {
    "/api/admin/finance/summary": {
      "get": {
        "summary": "Read finance totals by currency",
        "parameters": [{ "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }],
        "responses": { "200": { "description": "Verified payment, order, cost estimate, refund, and data coverage totals, separated by currency" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/admin/finance/transactions": {
      "get": {
        "summary": "List paginated customer payments and orders",
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "name": "status", "in": "query", "schema": { "type": "string", "maxLength": 32 } }, { "name": "currency", "in": "query", "schema": { "type": "string", "pattern": "^[A-Z]{3}$" } }],
        "responses": { "200": { "description": "Sanitized paginated records" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/admin/finance/revenue-chart": {
      "get": {
        "summary": "Read daily totals grouped by currency",
        "parameters": [{ "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }],
        "responses": { "200": { "description": "Daily verified payment and order totals by currency" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/admin/suppliers": {
      "get": { "summary": "List configured supplier accounts and cached balance snapshots", "responses": { "200": { "description": "Three configured accounts with capability and freshness labels; secrets excluded" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "post": {
        "summary": "Record a confirmed manual supplier balance",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["action", "supplierId", "walletId", "amount", "currency", "confirmation"], "properties": { "action": { "const": "manual-balance" }, "supplierId": { "$ref": "#/components/schemas/SupplierId" }, "walletId": { "$ref": "#/components/schemas/WalletId" }, "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,4})?$" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "confirmation": { "const": "RECORD MANUAL BALANCE" } } } } },
        "responses": { "201": { "description": "Manual balance snapshot recorded and audit logged" }, "400": { "description": "Invalid action or input" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/admin/suppliers/{supplierId}": {
      "get": { "summary": "Read supplier account details", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }], "responses": { "200": { "description": "Safe configuration, capability, last status, and latest snapshots" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Unknown supplier" } } }
    },
    "/api/admin/suppliers/{supplierId}/balance": {
      "get": { "summary": "Read the latest cached supplier balance snapshots", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }], "responses": { "200": { "description": "Latest live or manual snapshots with freshness labels" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/admin/suppliers/{supplierId}/test-connection": {
      "post": { "summary": "Test supplier API credentials and connectivity", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }], "responses": { "200": { "description": "Sanitized connection status" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "502": { "description": "Supplier connection failed" } } }
    },
    "/api/admin/suppliers/{supplierId}/sync-balance": {
      "post": { "summary": "Fetch and store the supplier's live balance", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }], "responses": { "200": { "description": "New verified snapshot" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "502": { "description": "Balance unavailable; no zero balance is recorded" } } }
    },
    "/api/admin/suppliers/{supplierId}/balance-history": {
      "get": { "summary": "List supplier balance snapshots", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Paginated live and manual snapshots" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/admin/suppliers/{supplierId}/orders": {
      "get": { "summary": "List this supplier's orders", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Paginated sanitized supplier orders" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/admin/suppliers/{supplierId}/services": {
      "get": { "summary": "List mapped supplier services", "parameters": [{ "$ref": "#/components/parameters/SupplierIdPath" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Paginated service IDs and safe display values" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    }
  },
  "components": {
    "securitySchemes": { "adminCookie": { "type": "apiKey", "in": "cookie", "name": "saksuuu_admin_token" } },
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "From": { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
      "To": { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } },
      "SupplierIdPath": { "name": "supplierId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/SupplierId" } }
    },
    "schemas": {
      "SupplierId": { "type": "string", "enum": ["vngzz2", "g2bulk", "webbuilder"] },
      "WalletId": { "type": "string", "enum": ["game", "smm", "available", "reserved"] }
    },
    "responses": { "Unauthorized": { "description": "Admin session required" } }
  }
}
